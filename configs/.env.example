# =====================================================================
# .env.example — Environment variable configuration template
# =====================================================================
#
# Purpose:
#   Template for creating a real .env file with project settings.
#   Lists all supported environment variables with notes and examples.
#   Never contains real passwords or API keys — placeholders only.
#
# HOW TO USE THIS FILE:
#   1. Copy (do not rename!) this file to .env
#      Linux/Mac: cp .env.example .env
#      Windows:   copy .env.example .env
#
#   2. Open .env in a text editor
#
#   3. Uncomment the lines you need (remove the leading #)
#
#   4. Replace placeholder values with your real data
#
#   5. Save the file
#
# RULES:
#   - Do not use quotes for values without spaces:
#       Correct:   PORT=587
#       Redundant: PORT="587"
#
#   - Use quotes for values with spaces or special characters:
#       Correct: ADMIN_NAME="Jane Smith"
#       Correct: IP_FULL_NAME='IE Ivanov I., TIN 123...'
# =====================================================================

# ---------------------------------------------------------------------
# Mail (required) — used by utils/mailer.php
# ---------------------------------------------------------------------
# USERNAME=your-email@gmail.com
# PASSWORD=your-app-password-here

# Mail (optional) — Gmail defaults apply if omitted
# HOST=smtp.gmail.com
# PORT=587
# ENCRYPTION=tls
# CHARSET=UTF-8

# ---------------------------------------------------------------------
# Admin copy of order emails — used by checkout.php
# ---------------------------------------------------------------------
# ADMIN_NAME="Order administrator"
# ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------
# Seller bank details — used by src/Invoice.php
# ---------------------------------------------------------------------
# RECIPIENT_BANK='BRANCH "EXAMPLE" OF "EXAMPLE BANK" city Example'
# BANK_IDENTIFICATION_CODE='123456789'
# CORRESPONDENT_BANK_ACCOUNT='30101000000000000000'
# INN='1234567890'
# RECIPIENTS_BANK_ACCOUNT='40802000000000000000'
# IP_NAME='IE Ivan Ivanov'
# IP_FULL_NAME='IE Ivan Ivanov, TIN 123456789876, 123456, Example region, Example city, Example st., 12, tel: +7 (123) 456-78-90'
# PAYMENT_BASIS='Main contract'
# ENTREPRENEURS_SURNAME='Ivanov I.'

# ---------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------
# DEBUG=true
